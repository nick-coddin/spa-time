        },
        "text_2": {
          "type": "text",
          "settings": {
            "text": "<p>Welke uitvoering je ook kiest, je kiest altijd voor een volwaardige Spa Time. Geen uitgeklede basis die eerst met allerlei opties uitgebreid moet worden, maar drie zorgvuldig samengestelde uitvoeringen met ieder hun eigen niveau van luxe.</p>"
          }
        },
        "divider_3": {
          "type": "divider",
