{%- comment -%}
  Blokvolgorde bepaalt de tabel: een "Groep"-blok start een nieuwe categorie, de "Rij"-blokken eronder horen erbij.
{%- endcomment -%}
<section class="compare bg-{{ section.settings.background }} pad-{{ section.settings.padding }}">
  <div class="container stack stack--lg">
    <div class="section-head"><div class="stack">{% render 'st-eyebrow', text: section.settings.eyebrow %}<h2 class="st-heading st-heading--h2">{{ section.settings.heading }}</h2></div>{%- if section.settings.text != blank -%}<div class="st-rte section-head__aside">{{ section.settings.text }}</div>{%- endif -%}</div>
    <div class="compare__scroll">
      <table class="compare__table" data-highlight="{{ section.settings.highlight }}">
        <thead><tr><th>{{ 'spatime.compare.category' | t }}</th><th>{{ 'spatime.compare.feature' | t }}</th>
          {%- for i in (1..3) -%}{%- assign k = 'col_' | append: i -%}<th class="compare__col{% if section.settings.highlight == i %} is-hl{% endif %}">{%- if section.settings.highlight == i -%}<span class="badge badge--sm">{{ 'spatime.most_chosen' | t }}</span>{%- endif -%}{{ section.settings[k] }}</th>{%- endfor -%}
        </tr></thead>
        <tbody>
        {%- assign group_title = '' -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'group' -%}
            {%- comment -%} tel rijen tot volgende groep voor rowspan {%- endcomment -%}
            {%- assign span = 0 -%}{%- assign start = forloop.index -%}
            {%- for b in section.blocks offset: start -%}{%- if b.type == 'group' -%}{%- break -%}{%- endif -%}{%- assign span = span | plus: 1 -%}{%- endfor -%}
            {%- assign g = block -%}{%- assign first_row = true -%}
          {%- else -%}
            <tr {{ block.shopify_attributes }}>
              {%- if first_row -%}<th scope="rowgroup" rowspan="{{ span }}" class="compare__group" {{ g.shopify_attributes }}>{% render 'st-icon', name: g.settings.icon, size: 30 %}<span>{{ g.settings.title }}</span></th>{%- assign first_row = false -%}{%- endif -%}
              <td>{{ block.settings.label }}</td>
              {%- for i in (1..3) -%}{%- assign k = 'col_' | append: i -%}
                <td class="compare__cell{% if section.settings.highlight == i %} is-hl{% endif %}">{%- if block.settings[k] -%}<span class="sr-only">{{ 'spatime.a11y.yes' | t }}</span>{% render 'st-icon', name: 'check', size: 17, stroke: 1.8 %}{%- else -%}<span class="compare__no" aria-label="{{ 'spatime.a11y.no' | t }}">–</span>{%- endif -%}</td>
              {%- endfor -%}
            </tr>
          {%- endif -%}
        {%- endfor -%}
        </tbody>
      </table>
    </div>
  </div>
</section>

