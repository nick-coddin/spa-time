<section class="features bg-{{ section.settings.background }} pad-{{ section.settings.padding }}">
  <div class="container features__wrap features__wrap--{{ section.settings.intro_position }}">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <div class="features__intro stack">
        {% render 'st-eyebrow', text: section.settings.eyebrow %}
        {%- if section.settings.heading != blank -%}<h2 class="st-heading st-heading--h2">{{ section.settings.heading | newline_to_br }}</h2>{%- endif -%}
        {%- if section.settings.text != blank -%}<div class="st-rte">{{ section.settings.text }}</div>{%- endif -%}
        {% render 'st-button', label: section.settings.button_label, link: section.settings.button_link %}
      </div>
    {%- endif -%}
    <div class="features__grid features__grid--{{ section.settings.style }}" style="--cols:{{ section.blocks.size }}">
      {%- for block in section.blocks -%}
        <div class="feature" {{ block.shopify_attributes }}>
          {% render 'st-icon', name: block.settings.icon, size: section.settings.icon_size, stroke: 1.1 %}
          <div><h3 class="feature__title">{{ block.settings.title }}</h3>{%- if block.settings.text != blank -%}<p class="feature__text">{{ block.settings.text }}</p>{%- endif -%}</div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

