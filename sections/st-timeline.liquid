<section class="timeline bg-{{ section.settings.background }} pad-{{ section.settings.padding }}">
  <div class="timeline__wrap container">
    <div class="timeline__aside"><span class="timeline__year">{{ section.settings.year }}</span><span class="timeline__line"></span></div>
    <div class="timeline__chapters">
      {%- for block in section.blocks -%}
        <article class="timeline__chapter" {{ block.shopify_attributes }}><h2 class="st-heading st-heading--h2">{{ block.settings.heading }}</h2><div class="st-rte">{{ block.settings.text }}</div></article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "ST · Tijdlijn / verhaal",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "year",
      "label": "Jaartal",
      "default": "2020"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Achtergrond",
      "options": [
        {
          "value": "cream",
          "label": "Crème"
        },
        {
          "value": "soft",
          "label": "Licht"
        },
        {
          "value": "sand",
          "label": "Zand"
        },
        {
          "value": "dark",
          "label": "Donker"
        }
      ],
      "default": "cream"
    },
    {
      "type": "select",
      "id": "padding",
      "label": "Verticale ruimte",
      "options": [
        {
          "value": "none",
          "label": "Geen"
        },
        {
          "value": "sm",
          "label": "Klein"
        },
        {
          "value": "md",
          "label": "Normaal"
        },
        {
          "value": "lg",
          "label": "Groot"
        }
      ],
      "default": "md"
    }
  ],
  "blocks": [
    {
      "type": "chapter",
      "name": "Hoofdstuk",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Kop",
          "default": "Waar het begon."
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Tekst"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ST · Tijdlijn",
      "blocks": [
        {
          "type": "chapter"
        },
        {
          "type": "chapter"
        },
        {
          "type": "chapter"
        }
      ]
    }
  ],
  "class": "st"
}
{% endschema %}
