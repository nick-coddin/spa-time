{%- comment -%}
  product.custom.specs = lijst metaobjecten "specificatie" (label, value); product.custom.top_view = afbeelding; custom.width_cm / custom.length_cm.
{%- endcomment -%}
<section class="specs pad-{{ section.settings.padding }}">
  <div class="specs__grid container">
    <div class="stack">
      <h2 class="st-heading st-heading--h2">{{ section.settings.heading | replace: '[product]', product.title }}</h2>
      <span class="muted">{{ section.settings.text }}</span>
      <dl class="specs__table">
        {%- for s in product.metafields.custom.specs.value -%}<div><dt>{{ s.label.value }}</dt><dd>{{ s.value.value }}</dd></div>{%- endfor -%}
      </dl>
    </div>
    {%- assign top = product.metafields.custom.top_view.value -%}
    {%- if top -%}
      <figure class="specs__figure">
        <div class="specs__img">{% render 'st-responsive-image', image: top, sizes: '(min-width: 1360px) 560px, (min-width: 990px) 42vw, 100vw', class: 'st-contain' %}</div>
        <span class="specs__dim specs__dim--v">{{ product.metafields.custom.length_cm }} cm</span>
        <span class="specs__dim specs__dim--h">{{ product.metafields.custom.width_cm }} cm</span>
      </figure>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "ST · Specificaties",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Kop",
      "default": "Specificaties [product]"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Subtekst",
      "default": "Alle technische specificaties overzichtelijk op een rij."
    },
    {
      "type": "select",
      "id": "padding",
      "label": "Verticale ruimte",
      "options": [
        {
          "value": "none",
          "label": "Geen"
        },
        {
          "value": "sm",
          "label": "Klein"
        },
        {
          "value": "md",
          "label": "Normaal"
        },
        {
          "value": "lg",
          "label": "Groot"
        }
      ],
      "default": "md"
    }
  ],
  "presets": [
    {
      "name": "ST · Specificaties"
    }
  ],
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "class": "st"
}
{% endschema %}
