<section class="feature-cards bg-{{ section.settings.background }} pad-{{ section.settings.padding }}">
  <div class="container stack stack--lg">
    <div class="stack">{% render 'st-eyebrow', text: section.settings.eyebrow %}<h2 class="st-heading st-heading--h2">{{ section.settings.heading }}</h2></div>
    <div class="feature-cards__grid">
      {%- for block in section.blocks -%}
        <article class="feature-card" {{ block.shopify_attributes }}>
          <div class="feature-card__media">{% render 'st-responsive-image', image: block.settings.image, sizes: '20vw', class: 'st-cover' %}</div>
          <div class="feature-card__body">{% render 'st-icon', name: block.settings.icon, size: 28 %}<h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p></div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

