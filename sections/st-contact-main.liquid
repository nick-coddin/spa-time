<section class="contact bg-{{ section.settings.background }} pad-{{ section.settings.padding }}">
  <div class="contact__grid container">
    <div class="stack">
      {% render 'st-eyebrow', text: section.settings.eyebrow %}
      <h2 class="st-heading st-heading--h2">{{ section.settings.heading }}</h2>
      <div class="st-rte">{{ section.settings.text }}</div>
      {%- form 'contact', id: 'ContactForm', class: 'form' -%}
        {%- if form.posted_successfully? -%}
          <div class="form__success">{% render 'st-icon', name: 'check', size: 28 %}<h3>{{ section.settings.success_heading }}</h3><p>{{ section.settings.success_text }}</p></div>
        {%- else -%}
          {%- if form.errors -%}<div class="form__error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
          <div class="form__row">
            <input class="st-field" name="contact[voornaam]" placeholder="Voornaam *" aria-label="Voornaam" required autocomplete="given-name">
            <input class="st-field" name="contact[achternaam]" placeholder="Achternaam *" aria-label="Achternaam" required autocomplete="family-name">
          </div>
          <input class="st-field" type="email" name="contact[email]" placeholder="E-mailadres *" aria-label="E-mailadres" required autocomplete="email" value="{{ customer.email }}">
          <input class="st-field" type="tel" name="contact[telefoon]" placeholder="Telefoonnummer" aria-label="Telefoonnummer" autocomplete="tel">
          <select class="st-field st-field--select" name="contact[onderwerp]" aria-label="Onderwerp">
            <option value="">Onderwerp</option>
            {%- assign subjects = section.settings.subjects | newline_to_br | split: '<br />' -%}
            {%- for s in subjects -%}{%- assign t = s | strip -%}{%- if t != blank -%}<option>{{ t }}</option>{%- endif -%}{%- endfor -%}
          </select>
          <textarea class="st-field" name="contact[body]" rows="5" placeholder="Je bericht *" aria-label="Je bericht" required></textarea>
          <button type="submit" class="btn btn--primary btn--full"><span>{{ section.settings.submit_label }}</span>{% render 'st-icon', name: 'arrow', size: 16, stroke: 1.4 %}</button>
        {%- endif -%}
      {%- endform -%}
    </div>
    <div class="contact__aside stack stack--lg">
      {% render 'st-eyebrow', text: section.settings.aside_eyebrow %}
      {%- for block in section.blocks -%}
        <div class="contact-item" {{ block.shopify_attributes }}>
          <span class="contact-item__icon">{% render 'st-icon', name: block.settings.icon, size: 26 %}</span>
          <div><strong>{{ block.settings.title }}</strong>
            {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" class="contact-item__value">{{ block.settings.value }}</a>{%- else -%}<span class="contact-item__value">{{ block.settings.value }}</span>{%- endif -%}
            {%- if block.settings.note != blank -%}<span class="contact-item__note">{{ block.settings.note }}</span>{%- endif -%}
            {%- if block.settings.cta_label != blank -%}<a href="{{ block.settings.cta_link }}" class="text-link">{{ block.settings.cta_label }} →</a>{%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

