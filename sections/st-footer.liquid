<footer class="site-footer">
  <div class="site-footer__grid container">
    {%- for block in section.blocks -%}
      <div class="site-footer__col" {{ block.shopify_attributes }}>
        {%- case block.type -%}
          {%- when 'brand' -%}
            <a href="{{ routes.root_url }}" class="brand brand--footer" aria-label="{{ shop.name }}">
              {%- if block.settings.logo -%}
                {{ block.settings.logo | image_url: width: 480 | image_tag: width: block.settings.logo_width, height: nil, alt: shop.name, class: 'brand__img', loading: 'lazy' }}
              {%- else -%}
                {% render 'st-wordmark' %}
              {%- endif -%}
            </a>
            <p class="site-footer__muted">{{ block.settings.text }}</p>
          {%- when 'menu' -%}
            <span class="site-footer__heading">{{ block.settings.heading }}</span>
            {%- for link in linklists[block.settings.menu].links -%}<a href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}
          {%- when 'contact' -%}
            <span class="site-footer__heading">{{ block.settings.heading }}</span>
            <span>{{ settings.address_line1 }}</span><span>{{ settings.address_line2 }}</span>
            <a href="tel:{{ settings.phone | remove: ' ' }}">{{ settings.phone }}</a>
            <a href="mailto:{{ settings.email }}">{{ settings.email }}</a>
        {%- endcase -%}
      </div>
    {%- endfor -%}
  </div>
  <div class="site-footer__bottom container">
    <span>© {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ 'spatime.footer.rights' | t }}</span>
    <nav>{%- for link in linklists[section.settings.legal_menu].links -%}<a href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}</nav>
  </div>
</footer>

{% schema %}
{
  "name": "ST · Footer",
  "settings": [
    {
      "type": "link_list",
      "id": "legal_menu",
      "label": "Juridisch menu",
      "default": "footer"
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Merk",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo",
          "info": "Leeg = tekstlogo uit Thema-instellingen › Spa Time · Merk."
        },
        {
          "type": "range",
          "id": "logo_width",
          "label": "Logobreedte",
          "min": 80,
          "max": 280,
          "step": 10,
          "unit": "px",
          "default": 180
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Tekst",
          "default": "Luxe jacuzzi's, compleet uitgerust. Zonder ingewikkelde keuzes."
        }
      ]
    },
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Kop",
          "default": "Collectie"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    },
    {
      "type": "contact",
      "name": "Contactgegevens",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Kop",
          "default": "Showroom"
        },
        {
          "type": "paragraph",
          "content": "Adres, telefoon en e-mail komen uit Thema-instellingen › Bedrijfsgegevens."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ST · Footer"
    }
  ],
  "class": "st"
}
{% endschema %}
