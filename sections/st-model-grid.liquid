<section class="model-grid bg-{{ section.settings.background }} pad-{{ section.settings.padding }}">
  <div class="container stack stack--lg">
    {%- if section.settings.heading != blank -%}
      <div class="section-head"><div class="stack">{% render 'st-eyebrow', text: section.settings.eyebrow %}<h2 class="st-heading st-heading--h2">{{ section.settings.heading }}</h2></div>{%- if section.settings.text != blank -%}<div class="st-rte section-head__aside">{{ section.settings.text }}</div>{%- endif -%}</div>
    {%- endif -%}
    {%- liquid
      if section.settings.source == 'current' and collection
        assign items = collection.products
      else
        assign items = section.settings.collection.products
      endif
    -%}
    <div class="grid-3">
      {%- for product in items limit: section.settings.limit -%}
        {% render 'st-model-card', product: product, cta_prefix: section.settings.cta_prefix, show_price: section.settings.show_price %}
      {%- else -%}
        <p>Kies een collectie in de editor.</p>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "ST · Modellen",
  "tag": "div",
  "settings": [
    {
      "type": "select",
      "id": "source",
      "label": "Bron",
      "options": [
        {
          "value": "current",
          "label": "Huidige collectie (collectiepagina)"
        },
        {
          "value": "picked",
          "label": "Gekozen collectie"
        }
      ],
      "default": "picked"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collectie"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Aantal",
      "min": 1,
      "max": 9,
      "step": 1,
      "default": 3
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Bovenkop"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Kop"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Tekst"
    },
    {
      "type": "text",
      "id": "cta_prefix",
      "label": "Knoptekst vóór modelnaam",
      "default": "Bekijk"
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Vanaf-prijs tonen",
      "default": true
    },
    {
      "type": "select",
      "id": "background",
      "label": "Achtergrond",
      "options": [
        {
          "value": "cream",
          "label": "Crème"
        },
        {
          "value": "soft",
          "label": "Licht"
        },
        {
          "value": "sand",
          "label": "Zand"
        },
        {
          "value": "dark",
          "label": "Donker"
        }
      ],
      "default": "cream"
    },
    {
      "type": "select",
      "id": "padding",
      "label": "Verticale ruimte",
      "options": [
        {
          "value": "none",
          "label": "Geen"
        },
        {
          "value": "sm",
          "label": "Klein"
        },
        {
          "value": "md",
          "label": "Normaal"
        },
        {
          "value": "lg",
          "label": "Groot"
        }
      ],
      "default": "md"
    }
  ],
  "presets": [
    {
      "name": "ST · Modellen"
    }
  ],
  "class": "st"
}
{% endschema %}
