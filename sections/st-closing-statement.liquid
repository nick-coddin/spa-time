<section class="statement bg-{{ section.settings.background }} pad-{{ section.settings.padding }}">
  <div class="container stack stack--lg">
    <span class="rule rule--wide"></span>
    {% render 'st-eyebrow', text: section.settings.eyebrow %}
    <p class="statement__text">{{ section.settings.text }} {% if section.settings.highlight != blank %}<span class="st-heading__accent">{{ section.settings.highlight }}</span>{% endif %}</p>
    <span class="rule rule--wide"></span>
    {%- if section.blocks.size > 0 -%}<div class="btn-row">{%- for block in section.blocks -%}{% render 'st-button', label: block.settings.label, link: block.settings.link, style: block.settings.style, icon: block.settings.icon, block: block %}{%- endfor -%}</div>{%- endif -%}
  </div>
</section>

{% schema %}
