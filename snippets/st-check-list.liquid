{%- comment -%} items: array of strings OR newline-separated string {%- endcomment -%}
{%- liquid
  if items.first == blank
    assign list = items | newline_to_br | split: '<br />'
  else
    assign list = items
  endif
-%}
<ul class="checks{% if variant == 'filled' %} checks--filled{% endif %}">
  {%- for item in list -%}{%- assign t = item | strip -%}{%- if t != blank -%}
  <li><span class="checks__mark">{% render 'st-icon', name: 'check', size: 14, stroke: 2 %}</span><span>{{ t }}</span></li>
  {%- endif -%}{%- endfor -%}
</ul>
