{%- comment -%} {% render 'st-model-card', product: product, cta_prefix: 'Bekijk', show_price: true %} {%- endcomment -%}
{%- assign persons = product.metafields.custom.persons.value -%}
{%- assign from_label = 'spatime.product.from' | t -%}
<article class="model-card">
  <a href="{{ product.url }}" class="model-card__media" tabindex="-1" aria-hidden="true">
    {% render 'st-responsive-image', image: product.featured_media.preview_image, sizes: '(min-width: 1360px) 400px, (min-width: 1060px) 31vw, (min-width: 680px) 47vw, 100vw', class: 'st-contain' %}
  </a>
  <div class="model-card__body">
    <h3 class="model-card__name">{{ product.title }}</h3>
    {%- if persons -%}<span class="eyebrow">{{ 'spatime.product.persons' | t: count: persons }}</span>{%- endif -%}
    <span class="st-divider"></span>
    <p class="model-card__tag">{{ product.metafields.custom.tagline.value }}</p>
    {%- if show_price -%}{% render 'st-price', amount: product.price_min, prefix: from_label, vat: true %}{%- endif -%}
    {%- assign cta_label = cta_prefix | append: ' ' | append: product.title -%}
    {% render 'st-button', label: cta_label, link: product.url, full: true %}
  </div>
</article>
